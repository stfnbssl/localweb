# Porta del server locale (default 4317)
PORT=4317

# Origini consentite per CORS (client Vite)
CORS_ORIGIN=http://localhost:5180

# Cartella radice dei dati locali (markdown / JSON). Default: ../data
# Il server la stampa all'avvio: due istanze avviate con DATA_DIR diverse sono
# indistinguibili da fuori, e scrivere sull'archivio sbagliato è un errore facile.
# Per provare qualcosa senza toccare i dati veri: DATA_DIR=../data-prova
DATA_DIR=../data

# --- Research System ---
# L'estrazione categorie avviene via spawn di Cowork (CLI `claude`), che usa
# l'autenticazione di Claude Code già presente sul sistema: nessuna chiave API qui.
# Cartella dei job di Cowork (default: ../cowork_jobs, relativo a server/)
COWORK_JOBS_DIR=../cowork_jobs
# Timeout dello spawn di Cowork in ms (default 120000)
COWORK_TIMEOUT_MS=120000
# Opzionali: chiavi per i motori di ricerca (funzionano anche senza)
SEMANTIC_SCHOLAR_API_KEY=
PUBMED_API_KEY=

# --- YouTube ---
# Pausa in ms fra un transcript e il successivo durante la sincronizzazione di un
# canale: le richieste partono tutte dallo stesso IP e in raffica YouTube blocca.
YOUTUBE_PAUSE_MS=1200
# API key della YouTube Data API v3 — OPZIONALE.
# Senza: l'elenco dei video arriva dal feed RSS pubblico, che espone gli ultimi 15
# video e non è paginabile. Con: si risale indietro nella cronologia quanto si
# vuole, e gli handle (@nome) si risolvono senza scraping della pagina.
# È gratuita e non richiede fatturazione: 10.000 unità di quota al giorno, di cui
# ne servono ~1 ogni 50 video. Si crea su console.cloud.google.com abilitando
# "YouTube Data API v3" e generando una API key.
# NB: non serve per i transcript — quelli l'API ufficiale non li dà per i canali
# altrui, e continuano ad arrivare da youtube-transcript.
API_KEY_YOUTUBE=
